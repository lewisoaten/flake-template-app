# Copy to .env for local overrides. .env is gitignored; never commit secrets.
# Every variable the application reads is prefixed APP_ and declared in
# src/app/core/settings.py — unknown APP_* variables are rejected at boot.

APP_ENVIRONMENT=local
APP_DEBUG=true
APP_PROJECT_NAME=Example App

APP_HOST=127.0.0.1
APP_PORT=8000

# SQLite for zero-dependency local dev. For the compose Postgres, use:
# APP_DATABASE_URL=postgresql+asyncpg://app:app@localhost:5432/app
# SQLite is rejected outside local/test.
APP_DATABASE_URL=sqlite+aiosqlite:///./app.db
APP_DATABASE_ECHO=false

# Required outside local/test. Generate with: just secret-key
# APP_SECRET_KEY=

# Superseded secrets, still accepted for reading. Lets you rotate the secret
# above without signing every session out or making encrypted columns
# unreadable. JSON list. See docs/SECURITY.md.
# APP_PREVIOUS_SECRET_KEYS=["the-old-secret"]

# --- Rate limiting ---------------------------------------------------------
# See src/app/core/ratelimit.py for the backend trade-off.
APP_RATE_LIMIT_ENABLED=true
APP_LOGIN_RATE_LIMIT=10
APP_LOGIN_RATE_LIMIT_WINDOW_SECONDS=300
APP_API_RATE_LIMIT=120
APP_API_RATE_LIMIT_WINDOW_SECONDS=60

# "database" shares counters across workers and hosts; "memory" is per process
# and therefore per worker.
APP_RATE_LIMIT_BACKEND=database

# --- Account lockout -------------------------------------------------------
# Protects an account, where rate limiting protects a source.
APP_ACCOUNT_LOCKOUT_ENABLED=true
APP_ACCOUNT_LOCKOUT_THRESHOLD=10
APP_ACCOUNT_LOCKOUT_SECONDS=900

# --- Password policy -------------------------------------------------------
# Offline strength rules always apply. This adds a k-anonymous Have I Been
# Pwned lookup, which makes an outbound call — hence off by default.
APP_PASSWORD_BREACH_CHECK_ENABLED=false

# --- Outbound webhooks -----------------------------------------------------
APP_WEBHOOK_TIMEOUT_SECONDS=10
APP_WEBHOOK_MAX_ATTEMPTS=3

# Endpoints resolving to private or loopback addresses are refused outside
# local/test. Set true only if you genuinely need to reach an internal host,
# and read the SSRF caveats in docs/SECURITY.md first.
APP_ALLOW_PRIVATE_WEBHOOK_TARGETS=false

# --- Inbound webhooks ------------------------------------------------------
# Shared secret a sender signs with. Unset means the inbound endpoint rejects
# everything, which is the correct default.
# APP_INBOUND_WEBHOOK_SECRET=
APP_INBOUND_WEBHOOK_TOLERANCE_SECONDS=300

# --- Transport -------------------------------------------------------------
# Enable once TLS terminates in front of the app.
APP_HSTS_ENABLED=false

# JSON list. Leave empty unless a separate origin calls the API from a browser.
# APP_CORS_ORIGINS=["https://app.example.com"]
