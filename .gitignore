# This repository holds flake templates. Everything under templates/ is
# *source*, including each template's own flake.lock — an instantiated project
# should get a pinned toolchain on day one.
#
# What must never be committed is anything a developer generates while testing
# a template in place, because `nix flake init` copies the directory verbatim
# into every new project.
#
# Add a section below when you add a language.

# --- any template ----------------------------------------------------------
templates/*/.direnv/
templates/*/.env
templates/*/result
templates/*/result-*

# --- py-fastapi-htmx ----------------------------------------------------------------
templates/py-fastapi-htmx/.venv/
templates/py-fastapi-htmx/.ruff_cache/
templates/py-fastapi-htmx/.pytest_cache/
templates/py-fastapi-htmx/htmlcov/
templates/py-fastapi-htmx/.coverage
templates/py-fastapi-htmx/*.db
templates/py-fastapi-htmx/*.db-wal
templates/py-fastapi-htmx/*.db-shm
templates/py-fastapi-htmx/openapi.json
templates/py-fastapi-htmx/clients/
templates/py-fastapi-htmx/test-results/
templates/py-fastapi-htmx/playwright-report/
# Generated by `just css`; the template ships the input, not the output.
templates/py-fastapi-htmx/src/app/static/css/app.css
# Browser deps (npm) and the copies `just vendor` makes. Never committed.
templates/py-fastapi-htmx/node_modules/
templates/py-fastapi-htmx/src/app/static/vendor/

# --- this repo -------------------------------------------------------------
__pycache__/
*.py[cod]

.direnv/
result
result-*
